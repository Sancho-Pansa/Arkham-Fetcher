{
  "name": "arkham-fetcher",
  "version": "1.0.0",
  "description": "NodeJS app to automatically fetch data about Arkham Horro tabletop game from open sources (fandom.com)",
  "main": "index.js",
  "directories": {
    "lib": "lib"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "run": "node dist/index.js",
